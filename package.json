{
  "name": "honorary-homes",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": "26.13.0",
    "pnpm": "12.15.0"
  },
  "scripts": {
    "ai:eval": "tsx scripts/ai-eval.ts",
    "build": "pnpm -r --if-present build",
    "claims:lint": "tsx scripts/claims-lint.ts",
    "deps:licenses": "tsx scripts/license-check.ts --prod && tsx scripts/license-check.ts --dev",
    "deps:licenses:dev": "tsx scripts/license-check.ts --dev",
    "deps:licenses:prod": "tsx scripts/license-check.ts --prod",
    "format": "prettier --write apps packages workers scripts tests *.ts *.mjs *.json *.yaml .github",
    "format:check": "prettier --check apps packages workers scripts tests *.ts *.mjs *.json *.yaml .github",
    "guard:approvals": "vitest run tests/governance/approval-gates.test.ts",
    "guard:protected": "tsx scripts/guard-protected.ts",
    "lint": "eslint apps packages workers scripts tests *.ts",
    "score:determinism": "vitest run tests/governance/score-determinism.test.ts",
    "secrets:scan": "tsx scripts/secret-scan.ts",
    "sim:budgets": "tsx scripts/check-budgets.ts",
    "sim:validate": "tsx scripts/validate-scenarios.ts",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "typecheck": "tsc -b",
    "verify": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm sim:validate && pnpm claims:lint && pnpm ai:eval && pnpm guard:approvals && pnpm score:determinism && pnpm sim:budgets && pnpm secrets:scan && pnpm deps:licenses && pnpm build"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/coverage-v8": "4.1.12",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "jsdom": "30.1.3",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.5",
    "vitest": "4.1.12"
  }
}
